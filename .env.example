# FeasAI 环境变量模板
# 使用方法：复制本文件为 .env 并填入真实 Key（.env 已被 .gitignore 忽略，不会提交）

# ---- 大模型（M2 启用；DeepSeek 示例，OpenAI 兼容协议）----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-在这里粘贴你的Key
LLM_MODEL=deepseek-chat

# ---- Embedding（示例：硅基流动 SiliconFlow 的 BGE 免费档；M2 启用）----
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_API_KEY=sk-在这里粘贴你的Key
EMBED_MODEL=BAAI/bge-m3

# 其他国内厂商（任选其一填上面即可）：通义 dashscope、智谱 zhipu、Kimi moonshot、百度千帆 等
